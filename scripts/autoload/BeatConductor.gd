extends Node
## Musical clock, beat/measure events and latency compensation (GDD §5.1, §7.1).
##
## Two time sources share one monotonic clock:
##   * audio — playback position + mix time − output latency − user calibration − stem
##     offset, used whenever a stream is actually playing;
##   * free-run — accumulated frame delta, used in headless tests, greybox scenes and
##     when audio is missing (missing audio is never fatal).
##
## `advance_clock()` is the deterministic stepping hook for tests and simulations.
## Beats are emitted from `_process`, never from a Timer. Rhythm evaluation must happen in
## `_input()` and read `get_song_time()` there.

signal beat_hit(beat: int)
signal measure_hit(measure: int)
signal bpm_changed(bpm: int)

const BEATS_PER_MEASURE := Config.BEATS_PER_MEASURE
## Generated by tools/make_click_track.py; dev scenes and the calibration wizard share it.
const CLICK_TRACK_DIR := "res://assets/audio/metronome"
## Backward clock jumps smaller than this are treated as mixer jitter and clamped away.
## Bigger jumps (stream restart, loop wrap) are accepted as a new anchor.
const MAX_BACKWARD_JUMP_S := 0.005
## Absorbs float rounding when a caller advances by an exact number of beats.
const BEAT_EPSILON_S := 0.000001
## Safety valve for pathological clock jumps (≈ 11 min at 142 BPM).
const MAX_BEATS_PER_STEP := 4096

@export var start_bpm := Config.PHASE_BPM[0]

var bpm := Config.PHASE_BPM[0]
var is_playing := false
## Leading silence of the assigned stem, in seconds (subtracted from audio time).
var stem_first_beat_offset := 0.0

var _player: AudioStreamPlayer
## Monotonic song time in seconds. Both time sources feed this value.
var _clock := 0.0
## Song time that corresponds to beat index 0 of the current musical grid.
var _grid_origin := 0.0
var _beat_index := 0
var _measure_index := 0


func _ready() -> void:
	process_priority = 100
	_player = get_node_or_null("AudioStreamPlayer") as AudioStreamPlayer
	if _player != null:
		_player.finished.connect(_on_stream_finished)
	bpm = start_bpm


func _process(delta: float) -> void:
	if not is_playing:
		return
	if _audio_is_playing():
		# get_song_time() pulls the compensated audio position and keeps it monotonic.
		get_song_time()
	else:
		_clock += maxf(delta, 0.0)
	_advance_beats(_clock)


## Starts (or restarts) the musical clock. Emits beat 0 and measure 0 immediately.
func start(p_bpm: int = -1) -> void:
	if p_bpm > 0:
		bpm = p_bpm
	_reset_musical_clock()
	is_playing = true
	if _player != null:
		if _player.stream != null:
			_player.play()
		else:
			_player.stop()
	beat_hit.emit(0)
	measure_hit.emit(0)


func stop() -> void:
	is_playing = false
	if _player != null:
		_player.stop()


## Phase boundary: a new tempo implies a new stem and a fresh musical clock.
func set_bpm(p_bpm: int) -> void:
	if p_bpm <= 0:
		return
	bpm = p_bpm
	_reset_musical_clock()
	if is_playing and _has_stream():
		_player.play()
	bpm_changed.emit(bpm)
	beat_hit.emit(0)
	measure_hit.emit(0)


## Assigns the audio stream used by get_song_time(). Does not start playback.
## `first_beat_offset` is the stem's leading silence in seconds.
func set_stream(stream: AudioStream, first_beat_offset: float = 0.0) -> void:
	stem_first_beat_offset = first_beat_offset
	if _player == null:
		return
	_player.stream = stream
	if stream is AudioStreamWAV:
		_enable_wav_loop(stream as AudioStreamWAV)


## Latency/calibration-compensated song time in seconds, clamped to >= 0.
## Audio-derived while a stream plays; the free-run clock otherwise. Monotonic across
## frames: jitter below MAX_BACKWARD_JUMP_S is ignored, larger re-anchors are accepted.
func get_song_time() -> float:
	if not is_playing:
		return _clock
	if _audio_is_playing():
		var candidate := compensated_song_time(
			_player.get_playback_position(),
			AudioServer.get_time_since_last_mix(),
			AudioServer.get_output_latency(),
			Settings.user_calibration_offset,
			stem_first_beat_offset
		)
		_integrate_candidate(candidate)
	return _clock


func beat_seconds() -> float:
	return Config.beat_seconds(float(bpm))


## Canonical path of a generated click/count-in track for `p_bpm`.
static func click_track_path(p_bpm: int, count_in: bool = false) -> String:
	var prefix := "countin" if count_in else "click"
	return "%s/%s_%d.wav" % [CLICK_TRACK_DIR, prefix, p_bpm]


## Absolute distance from `t` to the nearest beat, in [0, T/2] (GDD §5.1).
func delta_to_nearest_beat(t: float) -> float:
	var beat_s := beat_seconds()
	if beat_s <= 0.0:
		return 0.0
	var pos := fposmod(t - _grid_origin, beat_s)
	return minf(pos, beat_s - pos)


## Signed offset from `t` to the nearest beat, in [-T/2, +T/2): positive = late.
func signed_delta_to_nearest_beat(t: float) -> float:
	var beat_s := beat_seconds()
	if beat_s <= 0.0:
		return 0.0
	var pos := fposmod(t - _grid_origin, beat_s)
	if pos >= beat_s * 0.5:
		pos -= beat_s
	return pos


func get_beat_phase() -> float:
	var beat_s := beat_seconds()
	if beat_s <= 0.0:
		return 0.0
	return fposmod(_clock - _grid_origin, beat_s) / beat_s


func get_beat_index() -> int:
	return _beat_index


func get_measure_index() -> int:
	return _measure_index


func beats_until_next_measure() -> int:
	var within := _beat_index % BEATS_PER_MEASURE
	return BEATS_PER_MEASURE if within == 0 else BEATS_PER_MEASURE - within


## Deterministic stepping for tests and headless sims. Does not read wall-clock time.
func advance_clock(seconds: float) -> void:
	if not is_playing or seconds <= 0.0:
		return
	_clock = maxf(_clock + seconds, 0.0)
	_advance_beats(_clock)


## Pure latency equation from GDD §7.1, shared by the audio path and the unit tests.
## Positive `user_calibration` delays the musical clock (the player hears beats late).
static func compensated_song_time(
	playback_s: float,
	mix_s: float,
	output_latency_s: float,
	user_calibration_s: float,
	stem_first_beat_offset_s: float
) -> float:
	return maxf(
		playback_s + mix_s - output_latency_s - user_calibration_s - stem_first_beat_offset_s, 0.0
	)


## Pure monotonic policy. Small backward jitter holds the previous sample; a large
## backward jump is accepted because it means a new audio anchor (loop wrap/restart).
static func monotonic_time(
	previous: float, candidate: float, max_backward_jump: float = MAX_BACKWARD_JUMP_S
) -> float:
	var held := maxf(previous, 0.0)
	var next := maxf(candidate, 0.0)
	if next < held and held - next <= max_backward_jump:
		return held
	return next


func _reset_musical_clock() -> void:
	_clock = 0.0
	_grid_origin = 0.0
	_beat_index = 0
	_measure_index = 0


func _integrate_candidate(candidate: float) -> void:
	var backward := _clock - candidate
	var accepted := monotonic_time(_clock, candidate)
	if backward > MAX_BACKWARD_JUMP_S:
		# New anchor: keep the global beat index monotonic and re-grid the next beat
		# one period after the accepted position.
		_grid_origin = accepted - float(_beat_index) * beat_seconds()
	elif accepted > _clock:
		_clock = accepted
		return
	_clock = accepted


func _advance_beats(t: float) -> void:
	var beat_s := beat_seconds()
	if beat_s <= 0.0:
		return
	var target := int(floor((t - _grid_origin) / beat_s + BEAT_EPSILON_S))
	if target <= _beat_index:
		return
	var guard := 0
	while _beat_index < target and guard < MAX_BEATS_PER_STEP:
		guard += 1
		_beat_index += 1
		beat_hit.emit(_beat_index)
		if _beat_index % BEATS_PER_MEASURE == 0:
			_measure_index = int(_beat_index / BEATS_PER_MEASURE)
			measure_hit.emit(_measure_index)


func _audio_is_playing() -> bool:
	return _player != null and _player.stream != null and _player.playing


func _has_stream() -> bool:
	return _player != null and _player.stream != null


func _enable_wav_loop(wav: AudioStreamWAV) -> void:
	if wav.loop_mode != AudioStreamWAV.LOOP_DISABLED:
		return
	wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wav.loop_begin = 0
	wav.loop_end = int(round(wav.get_length() * float(wav.mix_rate)))


func _on_stream_finished() -> void:
	# Non-looping streams (ogg later) restart so the clock keeps a live audio anchor.
	if is_playing and _has_stream():
		_player.play()
